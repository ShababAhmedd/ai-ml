      "18\n"
     ]
    }
   ],
   "source": [
    "pattern = re.compile(r\"(\\w+)\\s(\\w+)\")\n",
    "y = pattern.findall(txt)\n",
    "for name, domain in y:\n",
    "    print(name)\n",
    "    print(domain)"
   ]
  }
